generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Company {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  taxId          String?
  email          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?
  country        String?   @default("ES")
  defaultTaxRate Decimal   @default(21) @db.Decimal(5, 2)
  currency       String    @default("EUR")
  orderPrefix    String    @default("PED")
  invoicePrefix  String    @default("FAC")
  quotePrefix    String    @default("PRE")
  poPrefix       String    @default("OC")
  creditNotePrefix String  @default("REC")
  defaultWarehouseId String?
  allowNegativeStock Boolean @default(false)
  monthlySalesTarget Decimal? @db.Decimal(12, 2)
  planId               String?
  trialEndsAt          DateTime?
  subscriptionStatus   String    @default("active")
  onboardingCompleted Boolean  @default(false)
  betaCohort         String?
  navigationPrefs    Json?
  platformNotes      String?   @db.Text
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  plan            Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  users           User[]
  roles           Role[]
  clients         Client[]
  products        Product[]
  employees       Employee[]
  suppliers       Supplier[]
  categories      Category[]
  warehouses      Warehouse[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  quotes          Quote[]
  purchaseOrders  PurchaseOrder[]
  auditLogs       AuditLog[]
  attachments     Attachment[]
  invitations     UserInvitation[]
  formLayouts     FormLayout[]
  refreshTokens   RefreshToken[]
  stockMovements  StockMovement[]
  payments        Payment[]
  entityCustomFieldData EntityCustomFieldData[]
  documentNumberSequences DocumentNumberSequence[]
  clientNotes     ClientNote[]
  defaultWarehouse Warehouse? @relation("CompanyDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  apiKeys         ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  bankAccounts    BankAccount[]
  bankMovements   BankMovement[]
  crmStages       CrmStage[]
  crmLeads        CrmLead[]
  crmOpportunities CrmOpportunity[]
  crmActivities   CrmActivity[]
  crmCatalogItems CrmCatalogItem[]
  crmEmailTemplates CrmEmailTemplate[]
  crmSmsTemplates CrmSmsTemplate[]
  crmEmailSettings CrmEmailSettings?
  crmAcreliaAccounts CrmAcreliaAccount[]
  crmIncidents      CrmIncident[]
  projects        Project[]
  timeEntries     TimeEntry[]
  boms            Bom[]
  manufacturingOrders ManufacturingOrder[]
  betaInvites         BetaInvite[]
  betaFeedback        BetaFeedback[]

  @@map("companies")
}

model DocumentNumberSequence {
  id        String   @id @default(uuid())
  companyId String
  docType   String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType, year])
  @@index([companyId])
  @@map("document_number_sequences")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String?
  lastName  String?
  isActive  Boolean   @default(true)
  emailVerified Boolean @default(false)
  verificationToken String? @unique
  verificationTokenExpires DateTime?
  companyId String
  roleId    String?
  notificationPrefs Json?
  isPlatformAdmin Boolean @default(false)
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  passwordResetToken String? @unique
  passwordResetExpires DateTime?
  lastLoginAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  role          Role?          @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  clientNotes   ClientNote[]
  crmLeadsAssigned       CrmLead[]        @relation("LeadAssignee")
  crmOpportunitiesAssigned CrmOpportunity[] @relation("OpportunityAssignee")
  crmActivitiesAssigned  CrmActivity[]    @relation("ActivityAssignee")
  crmActivitiesCreated   CrmActivity[]    @relation("ActivityCreator")
  crmIncidentsAssigned   CrmIncident[]    @relation("IncidentAssignee")

  @@index([companyId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company     Company          @relation(fields: [companyId], references: [id])
  users       User[]
  permissions RolePermission[]
  invitations UserInvitation[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  companyId String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @default(uuid())
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  userId    String?
  companyId String
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@id([id, createdAt])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model Attachment {
  id         String   @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String?
  size       Int?
  uploadedBy String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

model UserInvitation {
  id         String    @id @default(uuid())
  email      String
  companyId  String
  roleId     String?
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  role    Role?   @relation(fields: [roleId], references: [id])

  @@unique([companyId, email])
  @@map("user_invitations")
}

model FormLayout {
  id        String   @id @default(uuid())
  companyId String
  entityId  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, entityId])
  @@map("form_layouts")
}

model Client {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  email      String?
  phone      String?
  taxId      String?
  address    String?
  city       String?
  postalCode String?
  country    String?   @default("ES")
  notes      String?
  segment    String    @default("active")
  isActive   Boolean   @default(true)
  /// RGPD: datos personales suprimidos conservando el histórico fiscal
  anonymizedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id])
  salesOrders SalesOrder[]
  invoices    Invoice[]
  quotes      Quote[]
  clientNotes ClientNote[]
  crmLeads    CrmLead[]
  crmOpportunities CrmOpportunity[]
  crmActivities CrmActivity[]
  crmIncidents  CrmIncident[]
  projects      Project[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, segment])
  @@map("clients")
}

model ClientNote {
  id        String   @id @default(uuid())
  companyId String
  clientId  String
  userId    String?
  text      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([companyId])
  @@map("client_notes")
}

model Product {
  id          String    @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  category    String?
  categoryId  String?
  price       Decimal   @default(0) @db.Decimal(12, 2)
  cost        Decimal?  @db.Decimal(12, 2)
  stock       Int       @default(0)
  minStock    Int       @default(0)
  unit        String    @default("ud")
  barcode     String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company          Company           @relation(fields: [companyId], references: [id])
  categoryRef      Category?         @relation(fields: [categoryId], references: [id])
  warehouseStocks  WarehouseStock[]
  stockMovements   StockMovement[]
  salesOrderLines  SalesOrderLine[]
  invoiceLines     InvoiceLine[]
  quoteLines       QuoteLine[]
  purchaseOrderLines PurchaseOrderLine[]
  bomsAsFinished     Bom[]                 @relation("BomFinishedProduct")
  bomLinesAsComponent BomLine[]            @relation("BomComponentProduct")
  manufacturingOrders ManufacturingOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, isActive])
  @@index([categoryId])
  @@map("products")
}

model Employee {
  id         String    @id @default(uuid())
  companyId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  jobTitle   String?
  department String?
  imageUrl   String?
  hireDate   DateTime?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id])
  timeEntries TimeEntry[]

  @@index([companyId])
  @@index([companyId, lastName, firstName])
  @@map("employees")
}

model Supplier {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  email      String?
  phone      String?
  taxId      String?
  address    String?
  city       String?
  postalCode String?
  country    String?   @default("ES")
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company        Company         @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
  @@index([companyId, name])
  @@map("suppliers")
}

model Category {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Warehouse {
  id        String    @id @default(uuid())
  companyId String
  code      String
  name      String
  address   String?
  city      String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company          @relation(fields: [companyId], references: [id])
  stocks  WarehouseStock[]
  stockMovements StockMovement[]
  salesOrders SalesOrder[]
  purchaseOrders PurchaseOrder[]
  manufacturingOrders ManufacturingOrder[]
  defaultForCompanies Company[] @relation("CompanyDefaultWarehouse")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stocks")
}

model StockMovement {
  id            String   @id @default(uuid())
  companyId     String
  productId     String
  warehouseId   String
  type          String
  quantity      Int
  referenceType   String?
  referenceId     String?
  transferGroupId String?
  notes           String?
  createdBy     String?
  createdAt     DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([companyId, createdAt])
  @@index([productId])
  @@index([warehouseId])
  @@index([transferGroupId])
  @@map("stock_movements")
}

model SalesOrder {
  id         String    @id @default(uuid())
  companyId  String
  number     String
  clientId   String
  warehouseId String?
  status     String    @default("draft")
  orderDate  DateTime  @default(now())
  notes      String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingNumber  String?
  deliveryNotes       String?
  deliveryAddress     String?
  deliveryNoteNumber  String?
  subtotal   Decimal   @default(0) @db.Decimal(12, 2)
  taxRate    Decimal   @default(21) @db.Decimal(5, 2)
  taxAmount  Decimal   @default(0) @db.Decimal(12, 2)
  total      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company  Company          @relation(fields: [companyId], references: [id])
  client   Client           @relation(fields: [clientId], references: [id])
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  lines    SalesOrderLine[]
  invoices Invoice[]

  @@unique([companyId, number])
  @@unique([companyId, deliveryNoteNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, orderDate])
  @@index([companyId, createdAt])
  @@index([clientId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("sales_order_lines")
}

model Invoice {
  id         String    @id @default(uuid())
  companyId  String
  number     String
  clientId   String
  orderId    String?
  status     String    @default("draft")
  /// invoice | credit_note (factura rectificativa)
  documentType String  @default("invoice")
  originalInvoiceId String?
  creditReason String?  @db.Text
  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  notes      String?
  subtotal   Decimal   @default(0) @db.Decimal(12, 2)
  taxRate    Decimal   @default(21) @db.Decimal(5, 2)
  taxAmount  Decimal   @default(0) @db.Decimal(12, 2)
  total      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company Company       @relation(fields: [companyId], references: [id])
  client  Client        @relation(fields: [clientId], references: [id])
  order   SalesOrder?   @relation(fields: [orderId], references: [id])
  lines   InvoiceLine[]
  payments Payment[]
  timeEntries TimeEntry[]
  originalInvoice Invoice?  @relation("InvoiceCreditNotes", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  creditNotes     Invoice[] @relation("InvoiceCreditNotes")

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([companyId, issueDate])
  @@index([companyId, documentType])
  @@index([clientId])
  @@index([orderId])
  @@index([originalInvoiceId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id          String   @id @default(uuid())
  companyId   String
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now())
  method      String   @default("transfer")
  reference   String?
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bankMovement BankMovement?

  @@index([companyId, paymentDate])
  @@index([invoiceId])
  @@map("payments")
}

model Quote {
  id         String    @id @default(uuid())
  companyId  String
  number     String
  clientId   String
  status     String    @default("draft")
  quoteDate  DateTime  @default(now())
  validUntil DateTime?
  notes      String?
  subtotal   Decimal   @default(0) @db.Decimal(12, 2)
  taxRate    Decimal   @default(21) @db.Decimal(5, 2)
  taxAmount  Decimal   @default(0) @db.Decimal(12, 2)
  total      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company Company     @relation(fields: [companyId], references: [id])
  client  Client      @relation(fields: [clientId], references: [id])
  lines   QuoteLine[]
  crmOpportunity CrmOpportunity?

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, quoteDate])
  @@index([clientId])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(uuid())
  quoteId     String
  productId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_lines")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  companyId    String
  number       String
  supplierId   String
  warehouseId  String?
  status       String    @default("draft")
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?
  subtotal     Decimal   @default(0) @db.Decimal(12, 2)
  taxRate      Decimal   @default(21) @db.Decimal(5, 2)
  taxAmount    Decimal   @default(0) @db.Decimal(12, 2)
  total        Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company  Company             @relation(fields: [companyId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id])
  lines    PurchaseOrderLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, orderDate])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  productId        String?
  description      String
  quantity         Decimal @default(1) @db.Decimal(12, 2)
  unitPrice        Decimal @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal @default(0) @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model EntityCustomFieldData {
  entityType String
  entityId   String
  companyId  String
  values     Json     @default("{}")
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@id([entityType, entityId])
  @@index([companyId, entityType])
  @@map("entity_custom_field_data")
}

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  maxUsers     Int
  maxDocuments Int?
  features     Json     @default("{}")
  stripePriceId String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies Company[]

  @@map("plans")
}

model ApiKey {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  keyPrefix  String    @unique
  keyHash    String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  companyId String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String   @default(uuid())
  endpointId     String
  event          String
  payload        Json
  status         String
  responseStatus Int?
  responseBody   String?  @db.Text
  attempts       Int      @default(1)
  createdAt      DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([endpointId, createdAt])
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@map("platform_audit_logs")
}

model PlatformSettings {
  id                 String   @id @default("global")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  registrationMode   String   @default("open")
  betaSignupCap      Int?
  updatedAt          DateTime @updatedAt

  @@map("platform_settings")
}

model BetaInvite {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String?
  label     String    @default("beta-2026")
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  companyId String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([token])
  @@map("beta_invites")
}

model BetaFeedback {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  rating    Int?
  message   String   @db.Text
  page      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
  @@map("beta_feedback")
}

// --- D1 Contabilidad básica ---

model Account {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  type      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("accounts")
}

model JournalEntry {
  id            String   @id @default(uuid())
  companyId     String
  entryNumber   Int
  entryDate     DateTime @db.Date
  description   String
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, entryDate])
  @@index([companyId, referenceType, referenceId])
  @@map("journal_entries")
}

model JournalLine {
  id        String  @id @default(uuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  lineOrder Int     @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// --- D2 Tesorería ---

model BankAccount {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  iban           String?
  bankName       String?
  currency       String   @default("EUR")
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements BankMovement[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BankMovement {
  id            String   @id @default(uuid())
  companyId     String
  bankAccountId String
  movementDate  DateTime @db.Date
  description   String
  amount        Decimal  @db.Decimal(14, 2)
  type          String
  reference     String?
  status        String   @default("pending")
  paymentId     String?  @unique
  importBatchId String?
  createdBy     String?
  createdAt     DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([companyId, movementDate])
  @@index([bankAccountId])
  @@index([companyId, status])
  @@map("bank_movements")
}

// --- D3 CRM pipeline ---

model CrmStage {
  id        String   @id @default(uuid())
  companyId String
  name      String
  sortOrder Int
  color     String   @default("#6366f1")
  isClosed  Boolean  @default(false)
  outcome   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@unique([companyId, name])
  @@index([companyId, sortOrder])
  @@map("crm_stages")
}

model CrmLead {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String?
  phone        String?
  companyName  String?
  source       String?
  status       String   @default("new")
  statusId     String?
  notes        String?
  clientId     String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statusCatalog CrmCatalogItem?  @relation("LeadStatusCatalog", fields: [statusId], references: [id], onDelete: SetNull)
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  opportunities CrmOpportunity[]
  activities   CrmActivity[]
  incidents    CrmIncident[]

  @@index([companyId, status])
  @@index([companyId, statusId])
  @@map("crm_leads")
}

model CrmOpportunity {
  id                String    @id @default(uuid())
  companyId         String
  title             String
  stageId           String
  clientId          String?
  leadId            String?
  amount            Decimal?  @db.Decimal(14, 2)
  probability       Int       @default(50)
  expectedCloseDate DateTime? @db.Date
  status            String    @default("open")
  lostReason        String?
  quoteId           String?   @unique
  assignedToId      String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stage      CrmStage  @relation(fields: [stageId], references: [id])
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead       CrmLead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quote      Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("OpportunityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities CrmActivity[]
  incidents  CrmIncident[]

  @@index([companyId, stageId])
  @@index([companyId, status])
  @@map("crm_opportunities")
}

model CrmActivity {
  id            String    @id @default(uuid())
  companyId     String
  type                     String
  subject                  String
  description              String?
  dueAt                    DateTime?
  completedAt              DateTime?
  taskTypeId               String?
  subjectCatalogId         String?
  situationId              String?
  agendaClassificationId   String?
  leadId                   String?
  opportunityId            String?
  clientId                 String?
  assignedToId             String?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company                  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskTypeCatalog          CrmCatalogItem? @relation("ActivityTaskType", fields: [taskTypeId], references: [id], onDelete: SetNull)
  subjectCatalog           CrmCatalogItem? @relation("ActivitySubject", fields: [subjectCatalogId], references: [id], onDelete: SetNull)
  situationCatalog         CrmCatalogItem? @relation("ActivitySituation", fields: [situationId], references: [id], onDelete: SetNull)
  agendaClassification     CrmCatalogItem? @relation("ActivityAgenda", fields: [agendaClassificationId], references: [id], onDelete: SetNull)
  lead                     CrmLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo  User?           @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, dueAt])
  @@index([companyId, completedAt])
  @@map("crm_activities")
}

model CrmCatalogItem {
  id          String   @id @default(uuid())
  companyId   String
  category    String
  name        String
  code        String?
  description String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leadsStatus           CrmLead[]     @relation("LeadStatusCatalog")
  activitiesTaskType    CrmActivity[] @relation("ActivityTaskType")
  activitiesSubject     CrmActivity[] @relation("ActivitySubject")
  activitiesSituation   CrmActivity[] @relation("ActivitySituation")
  activitiesAgenda      CrmActivity[] @relation("ActivityAgenda")
  incidentsType         CrmIncident[] @relation("IncidentType")

  @@unique([companyId, category, name])
  @@index([companyId, category, sortOrder])
  @@map("crm_catalog_items")
}

model CrmEmailTemplate {
  id        String   @id @default(uuid())
  companyId String
  name      String
  subject   String
  bodyHtml  String   @db.Text
  bodyText  String?  @db.Text
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("crm_email_templates")
}

model CrmSmsTemplate {
  id        String   @id @default(uuid())
  companyId String
  name      String
  body      String   @db.Text
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("crm_sms_templates")
}

model CrmEmailSettings {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  fromName              String?
  fromEmail             String?
  replyTo               String?
  signatureHtml         String?  @db.Text
  copyTo                String?
  defaultEmailTemplateId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("crm_email_settings")
}

model CrmAcreliaAccount {
  id        String   @id @default(uuid())
  companyId String
  name      String
  apiKey    String?
  senderId  String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("crm_acrelia_accounts")
}

model CrmIncident {
  id              String    @id @default(uuid())
  companyId       String
  title           String
  description     String?
  status          String    @default("open")
  priority        String    @default("medium")
  typeId          String?
  clientId        String?
  leadId          String?
  opportunityId   String?
  assignedToId    String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeCatalog CrmCatalogItem?  @relation("IncidentType", fields: [typeId], references: [id], onDelete: SetNull)
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead        CrmLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignedTo  User?            @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, priority])
  @@map("crm_incidents")
}

// --- D4 Proyectos y horas ---

model Project {
  id          String    @id @default(uuid())
  companyId   String
  clientId    String
  name        String
  code        String?
  description String?
  status      String    @default("active")
  hourlyRate  Decimal   @default(0) @db.Decimal(10, 2)
  budgetHours Decimal?  @db.Decimal(10, 2)
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id])
  timeEntries TimeEntry[]

  @@index([companyId, status])
  @@index([clientId])
  @@map("projects")
}

model TimeEntry {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  employeeId  String
  entryDate   DateTime @db.Date
  hours       Decimal  @db.Decimal(6, 2)
  description String?
  billable    Boolean  @default(true)
  invoiceId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, entryDate])
  @@index([projectId])
  @@index([employeeId])
  @@map("time_entries")
}

model Bom {
  id        String   @id @default(uuid())
  companyId String
  productId String
  name      String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product             Product              @relation("BomFinishedProduct", fields: [productId], references: [id])
  lines               BomLine[]
  manufacturingOrders ManufacturingOrder[]

  @@unique([companyId, productId])
  @@index([companyId])
  @@map("boms")
}

model BomLine {
  id                 String  @id @default(uuid())
  bomId              String
  componentProductId String
  quantity           Decimal @db.Decimal(12, 4)
  lineOrder          Int     @default(0)

  bom       Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component Product @relation("BomComponentProduct", fields: [componentProductId], references: [id])

  @@index([bomId])
  @@map("bom_lines")
}

model ManufacturingOrder {
  id               String    @id @default(uuid())
  companyId        String
  number           String
  bomId            String
  productId        String
  warehouseId      String?
  quantity         Decimal   @db.Decimal(12, 4)
  quantityProduced Decimal   @default(0) @db.Decimal(12, 4)
  status           String    @default("draft")
  plannedDate      DateTime? @db.Date
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom       Bom        @relation(fields: [bomId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("manufacturing_orders")
}
