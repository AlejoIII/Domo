NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://erp:erp@localhost:5433/erp_saas?schema=public
# Sin Docker (Postgres apt/brew en 5432):
# DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_saas?schema=public
# Con PgBouncer (docker compose pgbouncer :6432):
# DATABASE_URL=postgresql://erp:erp@localhost:6432/erp_saas?schema=public&pgbouncer=true&connection_limit=10
# URL directa para migraciones Prisma (obligatoria si usas PgBouncer)
DATABASE_DIRECT_URL=postgresql://erp:erp@localhost:5433/erp_saas?schema=public
# Sin Docker: misma URL que DATABASE_URL (puerto 5432)
# Réplica de lectura opcional (dashboard/informes). Sin valor → usa primary.
# DATABASE_READ_URL=postgresql://erp:erp@localhost:5434/erp_saas?schema=public
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# Bloqueo de cuenta tras intentos fallidos de login
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# 2FA TOTP (Google Authenticator, etc.)
TOTP_ISSUER=Domo

# Cookies httpOnly para tokens JWT (recomendado en producción)
AUTH_EXPOSE_TOKENS_IN_BODY=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.tudominio.com

# Tras Cloudflare / reverse proxy (recomendado en producción)
# TRUST_PROXY=1

# Swagger /docs — en producción va OFF por defecto
# SWAGGER_ENABLED=true

# Métricas GET /api/metrics — en prod exige token (si no hay token → 404)
# METRICS_TOKEN=change-me-long-random-token

# Origen del frontend (CORS). En producción usar URL explícita; no usar *.
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (invitaciones y enlaces en emails)
FRONTEND_URL=http://localhost:5173

# Beta cerrada — registro invite-only y cupo de empresas
# Lanzamiento público (Fase 3): REGISTRATION_MODE=open y sin BETA_SIGNUP_CAP
# REGISTRATION_MODE=open|invite_only
REGISTRATION_MODE=open
# BETA_SIGNUP_CAP=10

# Email — provider: smtp | resend | console (recomendado en desarrollo)
EMAIL_PROVIDER=console
# Activar verificación por código al registrarse (true/false)
EMAIL_VERIFICATION_ENABLED=false

# Resend (alternativa a SMTP)
# RESEND_API_KEY=
# RESEND_FROM=Domo <onboarding@resend.dev>

REDIS_URL=redis://localhost:6379

# BullMQ worker — procesa webhooks, auditoría y emails en segundo plano
# Local: npm run start:worker:dev (junto con npm run start:dev)
# Docker: servicio worker en docker-compose.yml

# Alertas de cola (GET /api/metrics)
QUEUE_FAILED_ALERT_THRESHOLD=1
QUEUE_WAITING_ALERT_THRESHOLD=500

# Cache — Redis con fallback en memoria si Redis no está disponible
CACHE_DEFAULT_TTL_SEC=60
CACHE_DASHBOARD_TTL_SEC=60
CACHE_REPORTS_TTL_SEC=120
CACHE_SETTINGS_TTL_SEC=300
CACHE_PERMISSIONS_TTL_SEC=300
CACHE_KEY_PREFIX=domo:cache:

# SMTP — solo si EMAIL_PROVIDER=smtp
# Gmail: SMTP_USER = tu @gmail.com | SMTP_PASS = contraseña de aplicación
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicacion-16-caracteres
# SMTP_FROM=Domo <tu-cuenta@gmail.com>
# SMTP_TLS_REJECT=false

# Adjuntos — tamaño máximo en MB (default 10)
MAX_UPLOAD_MB=10

# Stripe (C2) — dejar vacío para desactivar pagos online
# Test: sk_test_... | Producción: sk_live_...
# STRIPE_SECRET_KEY=sk_test_...
# Local sin CLI: whsec_local_dev_c7 (ver docs/SMOKE_TEST_C7.md)
# Con Stripe CLI: npm run stripe:listen → copiar whsec_... aquí
# Producción: webhook en Stripe Dashboard → /api/v1/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs de tu dashboard Stripe (modo test o live)
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# Cambio manual de plan en Ajustes > Facturación (demo / pruebas).
# Por defecto: activo en NODE_ENV=development (aunque Stripe esté configurado).
# Forzar: true | false
# BILLING_ALLOW_PLAN_SWITCH=true

# Panel super-admin (C6) — solo interno; admin demo con isPlatformAdmin si true
# PLATFORM_ADMIN_ENABLED=true

# Rate limit API pública (por clave, ventana 60s)
# API_RATE_LIMIT_TTL_SEC=60
# API_RATE_LIMIT_MAX=120
STORAGE_DRIVER=local
# SIGNED_URL_TTL_SECONDS=900
# S3_BUCKET=
# S3_REGION=eu-west-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=          # MinIO / R2 (opcional)
# S3_PREFIX=uploads

# Observabilidad (opcional)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Bull Board — UI de colas BullMQ (solo con token; no exponer en prod público)
# BULL_BOARD_ENABLED=true
# BULL_BOARD_TOKEN=change-me-long-random-token
# LOG_LEVEL=info

# Verifactu / SIF (esqueleto — docs/VERIFACTU.md)
# VERIFACTU_SECRETS_KEY=change-me-verifactu-secrets-key-32chars
# VERIFACTU_SOFTWARE_NIF=B00000000
# VERIFACTU_SOFTWARE_VERSION=1.0.0
# VERIFACTU_AEAT_ENABLED=false
# VERIFACTU_AEAT_DRY_RUN=true
# VERIFACTU_AEAT_ENV=pre

# --- Producción (checklist) ---
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=1
# CORS_ORIGIN=https://app.tudominio.com
# FRONTEND_URL=https://app.tudominio.com
# EMAIL_PROVIDER=resend
# EMAIL_VERIFICATION_ENABLED=true
# STORAGE_DRIVER=s3
# JWT_SECRET=<openssl rand -hex 32>
# JWT_REFRESH_SECRET=<openssl rand -hex 32>
# METRICS_TOKEN=<openssl rand -hex 24>
# SWAGGER_ENABLED=false
# RUN_MIGRATIONS=true   # docker-entrypoint
