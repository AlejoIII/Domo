# API backend (proxy Vite en dev; URL pública en prod)

# VITE_API_URL=https://api.tudominio.com/api/v1



# Sentry (opcional — solo se activa tras consentimiento de cookies analíticas)

# VITE_SENTRY_DSN=https://...@sentry.io/...

# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1



# Versión mostrada en release de Sentry (CI prod usa git SHA)

# VITE_APP_VERSION=1.0.0



# Datos legales (obligatorios antes del lanzamiento público)

# VITE_LEGAL_COMPANY_NAME=Tu Empresa S.L.

# VITE_LEGAL_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España

# VITE_LEGAL_CIF=B12345678

# VITE_LEGAL_PRIVACY_EMAIL=privacidad@tudominio.com

# VITE_LEGAL_SUPPORT_EMAIL=soporte@tudominio.com

# Sesión: minutos de inactividad sin interacción → logout automático (default 15 = access JWT)
# VITE_SESSION_IDLE_MS=900000

